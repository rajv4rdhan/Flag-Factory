# ---------------------------------------------------------------------------
# Maze — environment (copy to .env and fill in). NEVER commit .env.
# ---------------------------------------------------------------------------

# The secret the bot must protect. Change it for each deployment.
MAZE_FLAG=flag{h0w_d1d_y0u_g3t_thr0ugh_th3_m4z3}

# Backend
BACKEND_PORT=8000
# Inference server the backend talks to (OpenAI-compatible)
INFERENCE_BASE_URL=http://inference:8080
INFERENCE_MODEL=qwen2.5-0.5b-instruct
# Generation
MAX_NEW_TOKENS=256
TEMPERATURE=0.7
TOP_P=0.95

# Limits
MAX_PROMPT_CHARS=2000
MAX_TURNS_PER_SESSION=40
RATE_LIMIT_PER_MINUTE=20

# Frontend
FRONTEND_PORT=3000

# Model download (used by `make model-download` and the inference image)
MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
